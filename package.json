{
  "name": "dsh-companion",
  "version": "0.1.9",
  "description": "A local, state-aware desktop companion overlay for DeepSeek Harness",
  "type": "module",
  "main": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./types": {
      "types": "./lib/types.d.ts",
      "default": "./lib/types.js"
    },
    "./client": {
      "types": "./lib/client.d.ts",
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "assets/suave-whale-boy/README.md",
    "assets/suave-whale-boy/suave-whale-boy-idle.webp",
    "cordis.patch.yml",
    "lib",
    "README.md",
    "README.en.md",
    "LICENSE"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=22.19.0"
  },
  "keywords": [
    "deepseek",
    "harness",
    "dsh",
    "plugin",
    "companion",
    "pet",
    "status"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Wanbinyu/dsh-companion.git"
  },
  "homepage": "https://github.com/Wanbinyu/dsh-companion#readme",
  "bugs": {
    "url": "https://github.com/Wanbinyu/dsh-companion/issues"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-primitives"
      ],
      "platform": "web"
    }
  },
  "scripts": {
    "build": "npm run build:host && npm run build:client",
    "build:host": "tsc -p tsconfig.host.json",
    "build:client": "npm run build:client:types && tsdown",
    "build:client:types": "tsc -p tsconfig.client.json",
    "typecheck": "npm run typecheck:host && npm run typecheck:client",
    "typecheck:host": "tsc -p tsconfig.host.json --noEmit",
    "typecheck:client": "tsc -p tsconfig.client.json --noEmit",
    "test": "vitest run",
    "pack:check": "npm pack --dry-run",
    "verify": "npm run typecheck && npm test && npm run build && npm run pack:check"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.1",
    "react": "^18.3.1",
    "zod": "^4.4.3"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-client-locale": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-client-runtime": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-client-ui-layout": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-client-ui-primitives": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-client-ui-slots": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-llm": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-session": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-session-projection": "^0.1.0-rc.6"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.1",
    "@deepseek-ai/dsh-client-locale": "0.1.0-rc.8",
    "@deepseek-ai/dsh-client-runtime": "0.1.0-rc.8",
    "@deepseek-ai/dsh-client-ui-layout": "0.1.0-rc.8",
    "@deepseek-ai/dsh-client-ui-primitives": "0.1.0-rc.8",
    "@deepseek-ai/dsh-client-ui-slots": "0.1.0-rc.8",
    "@deepseek-ai/dsh-llm": "0.1.0-rc.8",
    "@deepseek-ai/dsh-session": "0.1.0-rc.8",
    "@deepseek-ai/dsh-session-projection": "0.1.0-rc.8",
    "@types/node": "^22.20.0",
    "@types/react": "^18.3.12",
    "lightningcss": "^1.33.0",
    "tsdown": "^0.20.3",
    "typescript": "5.9.3",
    "vitest": "^4.1.8"
  }
}
